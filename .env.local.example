# HaqSaathi environment configuration.
# Copy to `.env.local` (git-ignored) and fill in real values for a live demo.

# --- Stage 4: recompute endpoint protection ---
# Shared secret required in the `x-recompute-secret` header to call
# POST /api/community-guidance/recompute. Any request without a matching
# secret gets a 403. Required for the demo's "recompute -> note appears" step.
RECOMPUTE_SECRET=change-me-to-a-long-random-string

# --- Stage 3: Cline SDK agent (optional) ---
# If unset (or FORCE_FALLBACK=1), the readiness check runs the deterministic
# path only, which is the product's source of truth. The SDK agent is an
# explanation layer that degrades to the deterministic path.
# CLINE_MODEL_API_KEY=
# CLINE_PROVIDER_ID=
# CLINE_MODEL_ID=
# FORCE_FALLBACK=1
# AGENT_TIMEOUT_MS=12000

# --- Test isolation (used by tests/stage4.test.ts, do not set in normal use) ---
# HAQSAATHI_DB_PATH points the app at an alternate SQLite file. Integration
# tests set this to a temp path so they never touch ./data/haqsaathi.db.
# HAQSAATHI_DB_PATH=./data/test.db
